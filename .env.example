NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://user:password@localhost:5432/infotech
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_TTL_HOURS=8
FRONTEND_URL=http://localhost:4174
TRUST_PROXY=false

# Vercel build-time variable for the static frontend. Set this to the Railway API URL in Vercel.
VITE_API_URL=http://localhost:8787

# Email is server-only and never exposed to the browser. Configure only if verification/reset emails are enabled.
RESEND_API_KEY=
EMAIL_FROM=Infotech <no-reply@example.com>

# One-time admin bootstrap; provide these only to the seed command, never commit them.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Owner
